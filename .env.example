# GoRefer — environment template. Copy to .env and fill values. NO secrets committed.
# Every flag + secret NAME is listed here with NO real value (implementation/10 §5, DoD).

# --- Django core ---
DJANGO_SECRET_KEY=            # required in prod; a random 50+ char string
DJANGO_DEBUG=true             # false in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL ONLY — M10) ---
# PostgreSQL is the sole supported engine (dev/test/CI/prod). There is NO SQLite
# fallback — settings fail-fast if the engine isn't Postgres. Create the DB + role
# first (see README "Running locally"):
#   CREATE ROLE gorefer LOGIN PASSWORD '…';
#   CREATE DATABASE gorefer_dev OWNER gorefer;
#   \c gorefer_dev
#   GRANT ALL ON SCHEMA public TO gorefer;
#   ALTER ROLE gorefer CREATEDB;   -- lets the test runner create gorefer_test
DB_NAME=gorefer_dev
DB_USER=gorefer
DB_PASSWORD=                  # secret — never commit (the gorefer role's password)
DB_HOST=127.0.0.1
DB_PORT=5432
TEST_DB_NAME=gorefer_test     # the test DB the pytest runner creates + tears down

# --- Env-bootstrap admin (implementation/10 §5) ---
# NO plaintext password anywhere. Provide a Django password HASH:
#   python -c "from django.contrib.auth.hashers import make_password; print(make_password('your-pw'))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- Partner / compliance (seeded; provider-agnostic) ---
PARTNER_CODE=ZMPHZC          # injected server-side into redirects; never client-facing
NSE_AP_NO=AP2516003693

# --- Feature flags (implementation/10 §4; defaults shown) ---
ENABLE_CUSTOMER_LOGIN=false
ENABLE_WATI_SEND=false
ENABLE_ZOHO_WRITE=false
ENABLE_ZOHO_READ=false       # M9: read-only Zoho enrichment (Referral Profile). Independent of ZOHO_WRITE (stays off for PIFS — Ashok enters leads manually, DF-9). Off = seeded fixtures.
ENABLE_ASSET_GENERATOR=false
ENABLE_ADMIN_DASHBOARD=true
ENABLE_DEMO_MODE=true

# --- Compliance: the single swappable incentive claim (ADR-014) ---
REFERRAL_INCENTIVE_CLAIM=10% brokerage share + 300 reward points

# --- PII masking (M9). Built now, dormant until ENABLE_CUSTOMER_LOGIN turns on. ---
# When on, the FUTURE customer/referrer view masks IP->city-only + phone->partial.
# The admin view always shows full detail.
PII_MASK_FOR_CUSTOMER_VIEW=true

# --- Background queue (django-q2, ORM broker — no Redis) ---
Q_ASYNC=false                # false = run tasks inline (dev/CI/demo). true + `manage.py qcluster` in prod.

# --- WATI (M5). Sending stays behind ENABLE_WATI_SEND until templates are Meta-approved. ---
WATI_BASE_URL=
WATI_API_TOKEN=              # secret — WATI bearer JWT (never inline; A7)
WATI_TENANT_ID=
WATI_BUSINESS_NUMBER=917080642020   # config: wa.me share target (digits only, NOT Ashok's personal)
OFFICE_ALERT_NUMBER=917388882020    # config: Ashok/office "new lead" alert recipient
SUPPORT_HELPLINE_PHONE=+91 73888 82020   # config: human helpline shown on the landing "call" line (Ashok; display format)

# --- Zoho. Lead WRITE stays behind ENABLE_ZOHO_WRITE (M6); READ enrichment (M9)
#     stays behind ENABLE_ZOHO_READ. Both use these OAuth creds; off = demo fixtures. ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=          # secret
ZOHO_REFRESH_TOKEN=          # secret
# Zoho status webhook auth (interim R2: static key + IP allowlist; HMAC = DF-2).
ZOHO_WEBHOOK_KEY=            # secret — shared key Zoho sends in X-Zoho-Webhook-Key
ZOHO_WEBHOOK_IP_ALLOWLIST=   # comma-separated Zoho server IPs; empty = allow any (dev only)

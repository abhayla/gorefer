# GoRefer — environment template. Copy to .env and fill values. NO secrets committed.
# Every flag + secret NAME is listed here with NO real value (implementation/10 §5, DoD).

# --- Django core ---
DJANGO_SECRET_KEY=            # REQUIRED in prod; a random 50+ char string. Boot FAILS if DEBUG=false and this is unset (uses the public insecure default).
DJANGO_DEBUG=false            # secure-by-default; set true ONLY in dev/CI. Prod MUST be false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL ONLY — M10) ---
# PostgreSQL is the sole supported engine (dev/test/CI/prod). There is NO SQLite
# fallback — settings fail-fast if the engine isn't Postgres. Create the DB + role
# first (see README "Running locally"):
#   CREATE ROLE gorefer LOGIN PASSWORD '…';
#   CREATE DATABASE gorefer_dev OWNER gorefer;
#   \c gorefer_dev
#   GRANT ALL ON SCHEMA public TO gorefer;
#   ALTER ROLE gorefer CREATEDB;   -- lets the test runner create gorefer_test
DB_NAME=gorefer_dev
DB_USER=gorefer
DB_PASSWORD=                  # secret — never commit (the gorefer role's password)
DB_HOST=127.0.0.1
DB_PORT=5432
TEST_DB_NAME=gorefer_test     # the test DB the pytest runner creates + tears down

# --- Env-bootstrap admin (implementation/10 §5) ---
# NO plaintext password anywhere. Provide a Django password HASH:
#   python -c "from django.contrib.auth.hashers import make_password; print(make_password('your-pw'))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- Partner / compliance (seeded; provider-agnostic) ---
PARTNER_CODE=ZMPHZC          # injected server-side into redirects; never client-facing
NSE_AP_NO=AP2516003693

# --- Feature flags (implementation/10 §4; defaults shown) ---
ENABLE_CUSTOMER_LOGIN=false
# NOTE: these three are the DEFAULT only. They are admin-editable at runtime from
# Settings → Integrations (checkboxes), and a saved override WINS over the value here
# (override → this env default). So an env change moves the flag only while no
# override row exists; check the Settings screen — it shows each flag's effective
# value AND its source (admin override vs env default).
ENABLE_WATI_SEND=false
ENABLE_ZOHO_WRITE=false
ENABLE_ZOHO_READ=false       # M9: read-only Zoho enrichment (Referral Profile). Independent of ZOHO_WRITE. Off = seeded fixtures.
ENABLE_ZOHO_WEBHOOK_HMAC=false  # DF-2 wax-seal on the status webhook. Off = interim static key + IP
                             # allowlist. On = HMAC(payload+timestamp+nonce) REQUIRED (no static-key
                             # fallback). Flip ON only once the Zoho Deluge signer is live.
ENABLE_ADMIN_DASHBOARD=true
ENABLE_DEMO_MODE=true
ENABLE_EMAIL_OTP=false        # T-078: ALSO email the login code to the on-file address (second leg alongside WhatsApp). Needs the EMAIL_* SMTP block below. Off = WhatsApp-only, exactly as before.
ENABLE_OTP_LOGIN=false        # Q-M-OTP: referrer self-service OTP login. Off = DemoOtpAdapter (log-only, sends nothing). Do NOT enable until the Sprint-2 customer-login gate + Wati auth template approved + delivery reliability fixed.
ENABLE_SHARE_HUB=false        # T-053: tokened referral share hub GET /hub/{token}, reached from a [Refer Link] button. Off = the whole route is absent. Opened by the SAME token as /rr/, but flagged separately so the two pages ship independently. Page copy (headline/intro/benefits/guidance) and the preview image are cascade keys `share_hub_*`, NOT env vars — the shipped copy is a placeholder pending owner compliance review. T-075: this flag ALSO mounts the LOGIN-GATED twin `GET /hub` (+ `POST /hub/opener`) — the same page, no token, identity from the session — but only when ENABLE_CUSTOMER_LOGIN is on too; with login off only the tokened route exists.
ENABLE_RECORDS_LINK=false    # T-051: tokened read-only records page GET /rr/{token}, reached from a WhatsApp [Referral Records] URL button. Off = the whole route is absent. Link lifetime is the cascade key `records_link_ttl_days` (default 90), NOT an env var — so it can be shortened for links already sent.

# --- Compliance: the single swappable incentive claim (ADR-014) ---
REFERRAL_INCENTIVE_CLAIM=10% brokerage share + 300 reward points

# --- PII masking (M9). Built now, dormant until ENABLE_CUSTOMER_LOGIN turns on. ---
# When on, the FUTURE customer/referrer view masks IP->city-only + phone->partial.
# The admin view always shows full detail.
PII_MASK_FOR_CUSTOMER_VIEW=true

# --- Background queue (django-q2, ORM broker — no Redis) ---
Q_ASYNC=false                # false = run tasks inline (dev/CI/demo). true + `manage.py qcluster` in prod.

# --- Rate limiting (Fable5 H3; DB-cache backed, no Redis). Run `manage.py createcachetable` once. ---
DJANGO_RATELIMIT_ENABLED=    # blank => true when DEBUG=false, false in dev. Explicit true/false overrides.
DJANGO_RATELIMIT_LOGIN_MAX=10        # failed admin logins per IP before lockout
DJANGO_RATELIMIT_LOGIN_WINDOW=900    # lockout window seconds (15 min)
DJANGO_RATELIMIT_LEADS_MAX=10        # POST /api/leads per IP per window
DJANGO_RATELIMIT_SHARE_MAX=30        # POST /api/share per IP per window
DJANGO_RATELIMIT_CLICK_MAX=60        # /api/click/* per IP per window
DJANGO_RATELIMIT_API_WINDOW=60       # window seconds for the per-minute API limits

# --- WATI (M5). Sending stays behind ENABLE_WATI_SEND until templates are Meta-approved. ---
WATI_BASE_URL=
WATI_API_TOKEN=              # secret — WATI bearer JWT (never inline; A7)
WATI_TENANT_ID=
WATI_BUSINESS_NUMBER=917080642020   # config: wa.me share target (digits only, NOT Ashok's personal)
OFFICE_ALERT_NUMBER=917388882020    # config: Ashok/office "new lead" alert recipient
SUPPORT_HELPLINE_PHONE=+91 73888 82020   # config: human helpline shown on the landing "call" line (Ashok; display format)

# --- Zoho. Lead WRITE stays behind ENABLE_ZOHO_WRITE (M6; Model 2 = idempotent
#     upsert keyed on normalized Mobile — never a blind create); READ enrichment (M9)
#     stays behind ENABLE_ZOHO_READ. Both use these OAuth creds; off = demo fixtures.
#     With the flag ON these are REQUIRED — the live adapter refuses to start without
#     them (fail loud, never silently live). ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=          # secret
ZOHO_REFRESH_TOKEN=          # secret
ZOHO_API_BASE=               # optional; defaults to https://www.zohoapis.in (.in DC)
ZOHO_ACCOUNTS_BASE=          # optional; defaults to https://accounts.zoho.in (OAuth token host,
                             # same DC as ZOHO_API_BASE — change both together)
# Zoho status webhook auth. Two modes, chosen by ENABLE_ZOHO_WEBHOOK_HMAC:
#   OFF (default) = interim R2: static key + IP allowlist.
#   ON  (DF-2 wax-seal) = HMAC(payload+timestamp+nonce) + the SAME IP allowlist.
#        The static key is NOT accepted as a fallback in this mode.
# Only flip ON once the Zoho-side Deluge signer is deployed, or every real webhook 401s.
ZOHO_WEBHOOK_KEY=            # secret — shared key Zoho sends in X-Zoho-Webhook-Key
ZOHO_WEBHOOK_IP_ALLOWLIST=   # DELIBERATELY EMPTY in prod: Zoho does not publish stable/enumerable egress IPs. The HMAC seal + Cloudflare origin lock are the controls (see docs/deploy/nginx/README.md). Leave empty; keep WEBHOOK_REQUIRE_IP_ALLOWLIST off.
# --- Webhook IP hardening (Fable5 H2) ---
DJANGO_TRUSTED_PROXY_HOPS=2  # trusted reverse-proxy hops (Cloudflare->nginx=2). Webhook IP is read from the (hops)-th X-Forwarded-For entry from the END, never the spoofable xff[0].
DJANGO_WEBHOOK_REQUIRE_IP_ALLOWLIST=false  # true = refuse an EMPTY webhook allowlist in prod. Flip ON only AFTER populating the *_WEBHOOK_IP_ALLOWLIST values.
ZOHO_WEBHOOK_HMAC_SECRET=    # secret — DF-2 seal; shared with the Zoho Deluge signer.
                             # REQUIRED when ENABLE_ZOHO_WEBHOOK_HMAC=true (unset = reject all)
ZOHO_WEBHOOK_MAX_SKEW_SECONDS=  # optional; default 300 — freshness window for a sealed request

# --- Records/hub token mint (T-054): POST /api/records-tokens/mint ---
# Shared secret held by the EXTERNAL senders of the [Referral Records] / [Refer Link]
# button (the Zoho Deluge fallback sweep, the Wati-Project broadcast scripts). They
# cannot compute a signed token, so they ask for one. UNSET = the endpoint refuses
# EVERY call (fail-closed) — that is the safe default, not a bug.
RECORDS_TOKEN_MINT_KEY=      # secret — sent by the caller in X-Records-Mint-Key
RECORDS_TOKEN_MINT_MAX_IDS=100   # max client_ids per request; page a bigger list in batches
DJANGO_RATELIMIT_MINT_MAX=10 # mint calls per minute per IP (each call issues credentials)

# --- WATI assisted-referral webhook auth (B4 / ADR-033; interim R2: key + allowlist). ---
WATI_WEBHOOK_KEY=            # secret — shared key Wati sends in X-Wati-Webhook-Key
WATI_WEBHOOK_IP_ALLOWLIST=   # comma-separated Wati server IPs; empty = allow any (dev only)

# --- OTP login (Q-M-OTP / ADR-035; behind ENABLE_OTP_LOGIN). Channel/order/limits are
#     per-tenant config edited on the Preferences screen — NOT here. Only the hash pepper
#     lives here. ---
OTP_HASH_PEPPER=            # secret — strengthens the OTP code hash (codes are stored hashed, never plaintext). Falls back to DJANGO_SECRET_KEY in dev.
OTP_WHATSAPP_TEMPLATE=gr_platform_gorefer_login_otp_en_2026_07_21   # config default: the Meta AUTHENTICATION template name (also editable per-tenant on the Preferences screen)

# --- Email OTP: the SECOND, simultaneous login-code channel (T-078). ---
# The same code also goes to the referrer's ON-FILE email (Zoho Contact / Customer) —
# never a typed address. Addition, not fallback: WhatsApp still sends exactly as before.
# Transport = Zoho Mail SMTP with an APP-SPECIFIC password (Zoho Mail → Settings →
# Security → App Passwords), NOT the account password. Subject/body copy is per-tenant
# config on the Preferences screen, not here.
# (the ENABLE_EMAIL_OTP flag itself lives in the feature-flag block above)
EMAIL_HOST=                # smtp.zoho.in   (use smtp.zoho.com for a .com account)
EMAIL_PORT=465               # 465 with SSL (Zoho's recommended); 587 would need EMAIL_USE_TLS=true + EMAIL_USE_SSL=false
EMAIL_HOST_USER=             # the full mailbox address that authenticates + sends, e.g. no-reply@gorefer.in
EMAIL_HOST_PASSWORD=         # SECRET — Zoho Mail app-specific password. Env only, never in a repo file.
EMAIL_USE_SSL=true           # SSL wins if both are set (Django refuses SSL+TLS together)
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=10             # seconds — a login must never hang on a stalled mail server
DEFAULT_FROM_EMAIL=          # From address; empty = EMAIL_HOST_USER. Zoho rejects a From that isn't the authenticated mailbox/alias.
EMAIL_SENDER_IDENTITY=Passive Income Financial Solutions   # sender identity line printed in the OTP email body
# EMAIL_BACKEND=             # leave unset in prod (SMTP). Tests use locmem; console backend is handy in dev.

# --- Google OAuth referrer login (M13 / ADR-027; behind ENABLE_CUSTOMER_LOGIN). ---
# Server-side authorization-code flow only — no Google JS on any page. Create the OAuth
# client in Google Cloud Console with redirect URI https://gorefer.in/login/google/callback.
# Both unset = the Google door simply doesn't render (the OTP door is independent).
GOOGLE_OAUTH_CLIENT_ID=      # from Google Cloud Console → Credentials → OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_SECRET=  # secret — env only, never in a repo file
GOOGLE_OAUTH_REDIRECT_URL=   # optional explicit redirect URI; empty = derived from the request host

# --- Share-channel attribution (M11 / ADR-028). ?s= captured then STRIPPED before the 302. ---
# The channel also rides as a PATH PREFIX /r/{channel}/{client_id} (B1) for WhatsApp URL buttons.
SHARE_CHANNEL_PARAM=s        # config: the query-param name read as the share channel (default s)

# --- Landing bypass (B3 / ADR-032). Per-tenant; central default page. ---
# LANDING_MODE=page|direct is resolved via the config cascade (a ConfigGlobal row per tenant),
# not a plain env var — direct logs the click then 302s straight to Zerodha, skipping the landing.
# MESSAGE_DISCLOSURE_LEVEL is DERIVED (never set): full iff direct AND no live /d/{slug}, else light.

# --- Open Graph / Twitter-Card preview (M11). Config-driven; NO partner code / Zerodha URL / clone. ---
OG_TITLE=Open a free Zerodha demat & trading account
OG_DESCRIPTION=You've been personally referred. PIFS helps you open your Zerodha account smoothly with trusted guidance. Investments in securities market are subject to market risks.
OG_IMAGE=img/og-card.png     # PIFS-branded card image (our own static, or an absolute https URL)
OG_SITE_NAME=GoRefer · PIFS
PUBLIC_BASE_URL=https://gorefer.in   # used to build absolute og:url / og:image

# --- Notifier gateway (T-032). Shared owner-notification service — GLOBAL.md §2. ---
# NOTIFIER_URL=http://127.0.0.1:3300  # same-VPS Notifier (localhost-only); off-VPS apps proxy via nginx
# NOTIFIER_KEY=                       # per-project API key, from the VPS notifier config, never committed

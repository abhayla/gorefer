diff --git a/templates/dashboard/preferences.html b/templates/dashboard/preferences.html
new file mode 100644
index 0000000..9e3588d
--- /dev/null
+++ b/templates/dashboard/preferences.html
@@ -0,0 +1,175 @@
+{% extends "dashboard/base.html" %}
+{% load static %}
+{% block title %}GoRefer Admin — Preferences{% endblock %}
+{% block content %}
+
+{% comment %}Preferences / Settings screen (Q-M-PREF · Variant C · ADR-034). The UI home
+for the per-tenant config cascade — LANDING_MODE is set HERE, not via a backend override.{% endcomment %}
+
+<div class="max-w-[760px] mx-auto space-y-4">
+
+  <div class="flex items-start justify-between gap-4">
+    <div>
+      <h1 class="text-[20px] font-extrabold tracking-tight">Preferences</h1>
+      <p class="text-[12.5px] text-ink-500 mt-0.5">
+        {{ sub_broker_name|default:"Your" }} · these settings apply to your referral links &amp; messages
+      </p>
+    </div>
+    {# Top Save — submits the same preferences form as the bottom Save (form="prefs_form"). #}
+    <button type="submit" form="prefs_form"
+            class="flex-none rounded-xl bg-cobalt-600 text-white px-5 py-2.5 text-[13.5px] font-semibold card">

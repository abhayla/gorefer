diff --git a/templates/dashboard/partials/landing_mode_callout.html b/templates/dashboard/partials/landing_mode_callout.html
new file mode 100644
index 0000000..221861d
--- /dev/null
+++ b/templates/dashboard/partials/landing_mode_callout.html
@@ -0,0 +1,18 @@
+{% comment %}
+Landing-mode compliance callout (Q-M-PREF / ADR-032). Rendered inline on GET and
+re-rendered via HTMX when the segment toggles. `live_disclosure` = the tenant has a
+live /d/{slug}; `requested_mode` (HTMX only) = the segment the user just clicked.
+{% endcomment %}
+{% if live_disclosure %}
+  <div class="mt-3 rounded-xl bg-cobalt-50 border border-cobalt-200 px-3 py-2.5 text-[11.5px] text-cobalt-600">
+    ✓ Safe to use “Direct” — your disclosure page
+    <b>gorefer.in/d/{{ slug }}</b> is live, so the required SEBI/NSE disclosures are
+    still one tap away from every message.
+  </div>
+{% else %}
+  <div class="mt-3 rounded-xl bg-pending/10 border border-pending/40 px-3 py-2.5 text-[11.5px] text-ink-700">
+    ⚠ “Direct to Zerodha” is unavailable until you have a live disclosure page
+    (<b>/d/{{ slug }}</b>). Add an active partnership below, then you can switch to
+    Direct. Until then, links show the landing page (which hosts the disclosures).
+  </div>
+{% endif %}
diff --git a/templates/dashboard/partials/partnerships.html b/templates/dashboard/partials/partnerships.html
new file mode 100644
index 0000000..3ae4bd7
--- /dev/null
+++ b/templates/dashboard/partials/partnerships.html
@@ -0,0 +1,77 @@
+{% comment %}
+Active partnerships list (Q-M-PREF). These ReferralProgram rows drive /d/{slug}
+composition (ADR-031). Add / activate / deactivate post via HTMX and swap this whole
+partial back in — so the disclosure-status callout above reflects the new live state.
+Wrapped in #partnerships so the HTMX target is stable.
+{% endcomment %}
+<div id="partnerships" hx-target="this" hx-swap="outerHTML">
+  <div class="text-[11.5px] text-ink-500 mb-2">Active partnerships (drive the disclosure page)</div>
+
+  {% if partnership_error %}
+    <div class="mb-2 rounded-lg bg-danger/10 border border-danger/40 px-3 py-2 text-[11.5px] text-danger">
+      {{ partnership_error }}
+    </div>
+  {% endif %}
+
+  <div class="divide-y divide-line">
+    {% for p in partnerships %}
+      <div class="flex items-center gap-2.5 py-2.5 text-[13px]">
+        <span class="font-semibold text-ink-900">{{ p.name }}</span>
+        <span class="text-[10.5px] text-ink-500 bg-bg rounded-md px-1.5 py-0.5">{{ p.regulator_label }}</span>
+        {% if p.active %}
+          <span class="text-[10px] font-bold text-positive bg-positive/10 rounded-full px-2 py-0.5">active</span>
+        {% else %}
+          <span class="text-[10px] font-bold text-ink-300 bg-bg rounded-full px-2 py-0.5">inactive</span>
+        {% endif %}
+        <div class="ml-auto">
+          {% if p.active %}
+            <button type="button" class="text-[11.5px] font-semibold text-ink-500 hover:text-danger"
+                    hx-post="{% url 'dashboard_preferences_partnership' %}"
+                    hx-vals='{"action": "deactivate", "program_id": "{{ p.id }}"}'
+                    hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'>Deactivate</button>
+          {% else %}
+            <button type="button" class="text-[11.5px] font-semibold text-cobalt-600 hover:text-cobalt-500"
+                    hx-post="{% url 'dashboard_preferences_partnership' %}"
+                    hx-vals='{"action": "activate", "program_id": "{{ p.id }}"}'
+                    hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'>Activate</button>
+          {% endif %}
+        </div>
+      </div>
+    {% empty %}
+      <div class="py-3 text-[12px] text-ink-300">No partnerships yet — add one below.</div>
+    {% endfor %}
+  </div>
+
+  {# Add partnership — a new partner/regulator is a data row, never a code change (ADR-031). #}
+  <details class="mt-3">
+    <summary class="inline-block cursor-pointer rounded-lg border border-dashed border-cobalt-200 text-cobalt-600 px-3 py-1.5 text-[12.5px] font-semibold select-none">
+      + Add partnership (Insurance · Loan · …)
+    </summary>
+    <div class="mt-2 flex flex-wrap items-end gap-2">
+      <label class="text-[11px] text-ink-500">
+        Name
+        <input name="name" class="mt-0.5 block w-48 rounded-lg border border-line px-2.5 py-1.5 text-[13px] focus:border-cobalt-500 focus:outline-none" placeholder="e.g. HDFC Life">
+      </label>
+      <label class="text-[11px] text-ink-500">
+        Regulator
+        <select name="regulator" class="mt-0.5 block w-40 rounded-lg border border-line px-2.5 py-1.5 text-[13px] bg-white focus:border-cobalt-500 focus:outline-none">
+          {% for code, label in regulator_choices %}
+            <option value="{{ code }}">{{ label }}</option>
+          {% endfor %}
+        </select>
+      </label>
+      <button type="button"
+              class="rounded-lg bg-cobalt-600 text-white px-3.5 py-1.5 text-[12.5px] font-semibold"
+              hx-post="{% url 'dashboard_preferences_partnership' %}"
+              hx-include="closest div"
+              hx-vals='{"action": "add"}'
+              hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'>Add</button>
+    </div>
+  </details>
+</div>
+
+{% comment %}Out-of-band: refresh the landing-mode compliance callout so it reflects the
+new live-disclosure state immediately after a partnership add/activate/deactivate.{% endcomment %}
+<div id="landing_mode_callout" hx-swap-oob="true">
+  {% include "dashboard/partials/landing_mode_callout.html" %}
+</div>
diff --git a/templates/dashboard/partials/pref_chip.html b/templates/dashboard/partials/pref_chip.html
new file mode 100644
index 0000000..ffae271
--- /dev/null
+++ b/templates/dashboard/partials/pref_chip.html
@@ -0,0 +1,22 @@
+{% comment %}
+Reusable share-channel chip. A checkbox styled as a pill (name=share_channels,
+value=code) so the enabled set submits natively as a multi-value field. WhatsApp +
+Copy are always-on (the primary CTAs) — shown checked and locked. Params: code, label,
+allowlist (the enabled codes). {% endcomment %}
+{% if code == "wa" or code == "copy" %}
+  <label class="inline-flex items-center rounded-lg border border-cobalt-200 bg-cobalt-50 text-cobalt-600 px-3 py-1.5 text-[12.5px] font-semibold cursor-default">
+    <input type="checkbox" name="share_channels" value="{{ code }}" class="sr-only" checked>
+    {{ label }}
+  </label>
+{% else %}
+  <label class="pref-chip inline-flex items-center rounded-lg border px-3 py-1.5 text-[12.5px] font-semibold cursor-pointer select-none
+                {% if code in allowlist %}border-cobalt-200 bg-cobalt-50 text-cobalt-600{% else %}border-line text-ink-500{% endif %}">
+    <input type="checkbox" name="share_channels" value="{{ code }}" class="peer sr-only" {% if code in allowlist %}checked{% endif %}
+           onchange="this.closest('label').classList.toggle('border-cobalt-200', this.checked);
+                     this.closest('label').classList.toggle('bg-cobalt-50', this.checked);
+                     this.closest('label').classList.toggle('text-cobalt-600', this.checked);
+                     this.closest('label').classList.toggle('border-line', !this.checked);
+                     this.closest('label').classList.toggle('text-ink-500', !this.checked);">
+    {{ label }}
+  </label>
+{% endif %}
diff --git a/templates/dashboard/partials/pref_toggle.html b/templates/dashboard/partials/pref_toggle.html
new file mode 100644

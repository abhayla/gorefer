@@ -0,0 +1,9 @@
+{% comment %}
+Reusable Variant-C toggle. A real checkbox (name=…, value="on") so it submits with the
+form natively — `on`=checked. peer-checked drives the visual switch. Params: name, on.
+{% endcomment %}
+<label class="relative inline-flex flex-none items-center cursor-pointer">
+  <input type="checkbox" name="{{ name }}" value="on" class="peer sr-only" {% if on %}checked{% endif %}>
+  <span class="w-11 h-6 rounded-full bg-ink-300/50 peer-checked:bg-cobalt-600 transition-colors"></span>
+  <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
+</label>
